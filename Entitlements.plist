<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Without this, the hardened runtime blocks the microphone before TCC is
         ever consulted, so the app never even appears in the Privacy list. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
